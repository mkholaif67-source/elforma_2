{
  "name": "elforma",
  "version": "1.0.16",
  "description": "ElForma - AI training & nutrition platform (full-stack, dependency-free)",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "test": "node test/api.test.js",
    "test:contracts": "node test/engine-contract.test.js",
    "test:mobile-nutrition": "node test/mobile-nutrition.test.js",
    "test:mobile-workout": "node test/mobile-workout.test.js",
    "test:mobile-progress": "node test/mobile-progress.test.js",
    "test:mobile-privacy": "node test/mobile-privacy.test.js",
    "test:mobile-adaptive": "node test/mobile-adaptive.test.js",
    "test:parity": "node test/parity.test.js",
    "test:push": "node test/push-devices.test.js",
    "test:engine-isolation": "node test/engine-isolation.test.js",
    "test:workout-gate": "node test/workout-gate.test.js",
    "test:security": "node test/security.test.js",
    "test:release-hygiene": "node test/release-hygiene.test.js",
    "test:translation-contract": "node test/translation-contract.test.js",
    "test:health-adjustments": "node test/health-adjustments.test.js",
    "test:edge-cases": "node test/edge-cases.test.js",
    "test:ci-config": "node test/ci-config.test.js",
    "test:all": "for f in test/*.test.js; do echo \"--- $f ---\"; node \"$f\" || exit 1; done",
    "admin:verify": "node --experimental-sqlite scripts/verify-admin.js",
    "release": "bash scripts/make-release.sh"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "libsql": "0.5.29"
  }
}
