# ElForma environment configuration (copy to .env for your deployment)
#
# ANYTHING MARKED [REQUIRED] MUST BE SET BEFORE YOUR FIRST REAL USER.
# Getting one of these wrong is the difference between a launch and an outage.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the server listens on
PORT=8000

# 'production' enables the Secure cookie flag (serve behind HTTPS)
EF_ENV=production

# [REQUIRED] Session signing secret. If this changes, every user is logged out.
# Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EF_SECRET=change-me-to-a-long-random-string

# [REQUIRED] Public base URL. Used in verification and password-reset links,
# so if it is wrong those emails send people to a dead address.
EF_BASE_URL=https://elforma.onrender.com

# ---------------------------------------------------------------------------
# Data + backups
# ---------------------------------------------------------------------------

# [REQUIRED] Where the SQLite database + secret file live.
# THIS MUST POINT AT A PERSISTENT VOLUME. On a normal container filesystem the
# database is wiped on every redeploy and every user account disappears.
EF_DATA_DIR=/var/data/elforma

# How many nightly database backups to keep before the oldest is pruned.
# The backup scheduler starts automatically with the server.
# NOTE: these backups live on the SAME disk as the database. They protect you
# from a bad migration or accidental deletion, NOT from losing the volume.
# Copy them off-box regularly if the data matters.
EF_BACKUP_KEEP=30

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------

# [REQUIRED] Comma-separated allowlist of admin emails. Admin powers (approving
# payments, changing prices, granting or deleting subscriptions, deleting users)
# are granted to any signed-in account whose email is on this list.
#
# TWO WARNINGS:
#   1. If you leave this empty you are LOCKED OUT of your own admin panel.
#   2. Whoever controls one of these inboxes can take over billing. Use an
#      address with a strong unique password and two-factor authentication.
EF_ADMIN_EMAILS=mokholaif7@gmail.com

# ---------------------------------------------------------------------------
# Database adapter and durability policy
# ---------------------------------------------------------------------------
# auto: Turso when TURSO_DATABASE_URL exists, otherwise local SQLite.
# Production should choose an engine explicitly and require durable storage.
EF_DATABASE_ENGINE=auto
EF_REQUIRE_DURABLE_DB=0

# ---------------------------------------------------------------------------
# Outgoing email
# ---------------------------------------------------------------------------

# Transactional email (account verification + password reset).
# If these are unset the server does NOT crash: it records the message to a
# local outbox and logs a warning. That means signup still works, but nobody
# can verify an address or recover a forgotten password. Set them before launch.
EF_MAIL_API_URL=https://api.your-mail-provider.com/send
EF_MAIL_API_KEY=
EF_MAIL_FROM=ElForma <no-reply@elforma.app>

# Optional one-time browser recovery for the allowlisted owner when Render
# Shell and outbound email are unavailable. Use at least 24 random characters,
# activate from /login.html, then delete this variable from Render.
EF_ADMIN_SETUP_TOKEN=
